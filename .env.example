# ============================================
# IDK.org Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to GitHub
#
# Variables marked "not read by the code yet" are placeholders for planned
# features. They do nothing today and can be left as they are.
# ============================================

# SERVER CONFIG
PORT=5000
NODE_ENV=development
# not read by the code yet
SERVER_URL=http://localhost:5000

# DATABASE
MONGODB_URI=mongodb://localhost:27017/idk-org
DATABASE_NAME=idk-org

# AI API (Claude - Anthropic) - for a future AI tutor (not read by the code yet; the tutor is rule-based today)
CLAUDE_API_KEY=your_claude_api_key_here
# Model used by the tutor. Configurable: pick the model that fits your cost/quality needs.
CLAUDE_MODEL=claude-sonnet-5-5

# JWT Authentication
# REQUIRED. The server refuses to start without it.
# In production it must be a real random value of at least 32 characters
# (placeholder values are rejected). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# FRONTEND URLs (used for CORS)
# In production, set WEB_URL to your frontend hosting origin (e.g. https://<username>.github.io)
WEB_URL=http://localhost:3000
MOBILE_URL=idk://app

# RATE LIMITING
# Maximum number of authentication attempts per 15 minutes per IP (defaults to 10)
AUTH_RATE_LIMIT_MAX=10
# Maximum number of tutor messages per 15 minutes per IP (defaults to 60)
TUTOR_RATE_LIMIT_MAX=60

# APP CONFIG (not read by the code yet; NODE_ENV above is what the code uses)
APP_NAME=IDK.org
APP_VERSION=0.1.0
ENVIRONMENT=development

# Logging (not read by the code yet)
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# CORS (not read by the code yet; WEB_URL and MOBILE_URL above are what the code uses)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Email (for future use, not read by the code yet)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Payment (for future use, not read by the code yet)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLIC_KEY=pk_test_your_key

# Redis (for caching - optional, not read by the code yet)
REDIS_URL=redis://localhost:6379

# Analytics (for future use, not read by the code yet)
ANALYTICS_KEY=your_analytics_key
